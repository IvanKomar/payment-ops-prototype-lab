{
  "name": "payment-ops-prototype-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build --concurrency=1",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck --concurrency=1",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "up": "pnpm run setup && pnpm run dev",
    "setup": "pnpm run docker:up && pnpm run prisma:generate && pnpm run db:deploy",
    "prisma:generate": "pnpm --filter @payment-ops/receipt-recognizer prisma:generate",
    "db:deploy": "set -a; [ -f .env ] && . ./.env; set +a; pnpm --filter @payment-ops/sms-gateway prisma:deploy && pnpm --filter @payment-ops/receipt-recognizer prisma:deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
