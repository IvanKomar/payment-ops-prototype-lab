POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=payment_ops
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payment_ops?schema=public
REDIS_URL=redis://localhost:6379
POSTGRES_VIEWER_URL=http://localhost:8080
REDIS_VIEWER_URL=http://localhost:5540

PORT=3001
SMS_GATEWAY_PORT=3001
RECEIPT_RECOGNIZER_PORT=3002
LAYOUT_BUILDER_PORT=3003
BUILDER_FRONTEND_PORT=3004
PAYMENT_CORE_PORT=3005
BRAND_RUNTIME_PORT=3006
LOG_LEVEL=info

SMS_MOCK_MIN_LATENCY_MS=100
SMS_MOCK_MAX_LATENCY_MS=800
SMS_MOCK_SUCCESS_RATE=0.95

FAST2SMS_ENABLED=false
FAST2SMS_API_KEY=

NORMALIZER=regex
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
RECEIPT_MAX_UPLOAD_BYTES=8388608

LAYOUT_LOGO_UPLOAD_DIR=uploads/logos
LAYOUT_MAX_UPLOAD_BYTES=3145728
LAYOUT_ADMIN_EMAIL=admin@payment-ops.local
LAYOUT_ADMIN_PASSWORD=local-admin-password
LAYOUT_DEV_ADMIN_FALLBACK=true
PAYMENT_SESSION_TTL_SECONDS=43200
PAYMENT_CORE_BASE_URL=http://localhost:3005
BRAND_AI_PROVIDER=gemini

VITE_SMS_API_BASE=/sms-api
VITE_RECEIPT_API_BASE=/receipt-api
VITE_LAYOUT_API_BASE=/layout-api
VITE_PAYMENT_API_BASE=/payment-api
VITE_BRAND_RUNTIME_BASE=http://localhost:3006
VITE_POSTGRES_VIEWER_URL=http://localhost:8080
VITE_REDIS_VIEWER_URL=http://localhost:5540
VITE_SMS_PROXY_TARGET=http://localhost:3001
VITE_RECEIPT_PROXY_TARGET=http://localhost:3002
VITE_LAYOUT_PROXY_TARGET=http://localhost:3003
VITE_PAYMENT_PROXY_TARGET=http://localhost:3005
VITE_BRAND_RUNTIME_PROXY_TARGET=http://localhost:3006
