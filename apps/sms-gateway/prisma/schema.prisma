generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SmsMessage {
  id                String    @id
  phoneNumber       String
  message           String
  idempotencyKey    String?   @unique
  metadata          Json?
  status            SmsStatus
  selectedProvider  String
  providerMessageId String?
  attempts          Int       @default(0)
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sentAt            DateTime?

  @@map("sms_messages")
}

model Receipt {
  id               String                @id
  originalFilename String
  mimeType         String
  sizeBytes        Int
  bank             String?
  transactionDate  String?
  amount           Float?
  currency         String?
  sender           String?
  recipient        String?
  transactionId    String?
  utr              String?
  confidence       Float
  normalizedBy     ReceiptNormalizerKind
  requestedModel   ReceiptRecognitionModel @default(tesseract)
  recognitionModel ReceiptRecognitionModel @default(tesseract)
  rawText          String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@map("receipts")
}

model Brand {
  id                   String         @id
  name                 String
  logoOriginalFilename String
  logoMimeType         String
  logoSizeBytes        Int
  logoPath             String
  palette              Json
  schemas              BrandSchema[]
  requests             BrandRequest[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@map("brands")
}

model BrandSchema {
  id          String         @id
  brandId     String
  brand       Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  slug        String         @unique
  fieldsStyle String
  structure   String
  fields      Json
  requests    BrandRequest[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([brandId])
  @@map("brand_schemas")
}

model BrandRequest {
  id               String      @id
  brandId          String
  brand            Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  schemaId         String
  schema           BrandSchema @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  originalPayload  Json
  canonicalPayload Json
  renderedSvg      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([brandId, createdAt])
  @@index([schemaId])
  @@map("brand_requests")
}

model PaymentUser {
  id           String           @id
  brandId      String
  email        String
  passwordHash String
  displayName  String
  accounts     PaymentAccount[]
  sessions     PaymentSession[]
  payments     Payment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([brandId, email])
  @@map("payment_users")
}

model PaymentAccount {
  id        String      @id
  brandId   String
  userId    String
  user      PaymentUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float       @default(0)
  currency  String
  payments  Payment[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([brandId, userId])
  @@map("payment_accounts")
}

model PaymentSession {
  id        String      @id
  brandId   String
  userId    String
  user      PaymentUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String      @unique
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@index([brandId, userId])
  @@map("payment_sessions")
}

model Payment {
  id                String            @id
  externalReference String            @unique
  brandId           String
  accountId         String
  account           PaymentAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId            String
  user              PaymentUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            PaymentStatus
  amount            Float
  currency          String
  payerLabel        String
  destinationLabel  String
  methodType        PaymentMethodType
  provider          String
  failureCode       String?
  events            PaymentEvent[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  authorizedAt      DateTime?
  capturedAt        DateTime?
  settledAt         DateTime?
  refundedAt        DateTime?

  @@index([brandId, accountId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

model PaymentEvent {
  id         String         @id
  paymentId  String
  payment    Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fromStatus PaymentStatus?
  toStatus   PaymentStatus
  reason     String
  createdAt  DateTime       @default(now())

  @@index([paymentId, createdAt])
  @@map("payment_events")
}

enum SmsStatus {
  queued
  processing
  sent
  failed
}

enum ReceiptNormalizerKind {
  regex
  gemini
  anthropic
}

enum ReceiptRecognitionModel {
  tesseract
  gemini
}

enum PaymentStatus {
  created
  requires_payment_method
  requires_confirmation
  processing
  authorized
  captured
  settled
  failed
  canceled
  refunded
}

enum PaymentMethodType {
  card
  bank_transfer
  wallet
  crypto
  manual
}
