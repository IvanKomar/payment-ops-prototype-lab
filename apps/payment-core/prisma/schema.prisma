generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SmsMessage {
  id                String    @id
  phoneNumber       String
  message           String
  idempotencyKey    String?   @unique
  metadata          Json?
  status            SmsStatus
  selectedProvider  String
  providerMessageId String?
  attempts          Int       @default(0)
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sentAt            DateTime?

  @@map("sms_messages")
}

model Receipt {
  id               String                @id
  originalFilename String
  mimeType         String
  sizeBytes        Int
  bank             String?
  transactionDate  String?
  amount           Float?
  currency         String?
  sender           String?
  recipient        String?
  transactionId    String?
  utr              String?
  confidence       Float
  normalizedBy     ReceiptNormalizerKind
  requestedModel   ReceiptRecognitionModel @default(tesseract)
  recognitionModel ReceiptRecognitionModel @default(tesseract)
  rawText          String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@map("receipts")
}

model Brand {
  id                   String         @id
  name                 String
  logoOriginalFilename String
  logoMimeType         String
  logoSizeBytes        Int
  logoPath             String
  palette              Json
  schemas              BrandSchema[]
  requests             BrandRequest[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@map("brands")
}

model BrandSchema {
  id          String         @id
  brandId     String
  brand       Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  slug        String         @unique
  fieldsStyle String
  structure   String
  fields      Json
  requests    BrandRequest[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([brandId])
  @@map("brand_schemas")
}

model BrandRequest {
  id               String      @id
  brandId          String
  brand            Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  schemaId         String
  schema           BrandSchema @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  originalPayload  Json
  canonicalPayload Json
  renderedSvg      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([brandId, createdAt])
  @@index([schemaId])
  @@map("brand_requests")
}

model PaymentUser {
  id           String           @id
  brandId      String
  email        String
  passwordHash String
  displayName  String
  accounts     PaymentAccount[]
  sessions     PaymentSession[]
  customers    PaymentCustomer[]
  paymentIntents PaymentIntent[]
  payments     Payment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([brandId, email])
  @@map("payment_users")
}

model PaymentAccount {
  id                  String               @id
  brandId             String
  userId              String
  user                PaymentUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance             Float                @default(0)
  currency            String
  customers           PaymentCustomer[]
  paymentMethods      PaymentMethod[]
  paymentIntents      PaymentIntent[]
  payments            Payment[]
  balanceTransactions BalanceTransaction[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([brandId, userId])
  @@map("payment_accounts")
}

model PaymentSession {
  id        String      @id
  brandId   String
  userId    String
  user      PaymentUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String      @unique
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@index([brandId, userId])
  @@map("payment_sessions")
}

model Payment {
  id                String            @id
  externalReference String            @unique
  brandId           String
  accountId         String
  account           PaymentAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId            String
  user              PaymentUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          PaymentCustomer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentMethodId   String?
  paymentMethod     PaymentMethod?     @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  paymentIntentId   String?
  paymentIntent     PaymentIntent?     @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  status            PaymentStatus
  amount            Float
  currency          String
  payerLabel        String
  destinationLabel  String
  methodType        PaymentMethodType
  provider          String
  failureCode       String?
  events            PaymentEvent[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  authorizedAt      DateTime?
  capturedAt        DateTime?
  settledAt         DateTime?
  refundedAt        DateTime?
  balanceMovements  BalanceTransaction[]

  @@index([brandId, accountId, createdAt])
  @@index([brandId, customerId, createdAt])
  @@index([brandId, paymentMethodId, createdAt])
  @@index([paymentIntentId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

model PaymentCustomer {
  id             String          @id
  brandId        String
  accountId      String
  account        PaymentAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId         String
  user           PaymentUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email          String?
  name           String
  phone          String?
  metadata       Json?
  paymentMethods PaymentMethod[]
  paymentIntents PaymentIntent[]
  payments       Payment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([brandId, accountId, email])
  @@index([brandId, accountId, createdAt])
  @@map("payment_customers")
}

model PaymentMethod {
  id             String            @id
  brandId        String
  accountId      String
  account        PaymentAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       PaymentCustomer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  type           PaymentMethodType
  label          String
  last4          String?
  brand          String?
  expiryMonth    Int?
  expiryYear     Int?
  bankName       String?
  metadata       Json?
  paymentIntents PaymentIntent[]
  payments       Payment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([brandId, accountId, createdAt])
  @@index([brandId, customerId, createdAt])
  @@map("payment_methods")
}

model PaymentIntent {
  id                String            @id
  externalReference String            @unique
  brandId           String
  accountId         String
  account           PaymentAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId            String
  user              PaymentUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          PaymentCustomer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentMethodId   String?
  paymentMethod     PaymentMethod?    @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  status            PaymentStatus
  amount            Float
  currency          String
  description       String?
  payments          Payment[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([brandId, accountId, createdAt])
  @@index([brandId, customerId, createdAt])
  @@index([status, createdAt])
  @@map("payment_intents")
}

model BalanceTransaction {
  id          String                        @id
  brandId     String
  accountId   String
  account     PaymentAccount                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  paymentId   String?
  payment     Payment?                      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  type        PaymentBalanceTransactionType
  amount      Float
  currency    String
  description String
  availableAt DateTime?
  createdAt   DateTime                      @default(now())

  @@index([brandId, accountId, createdAt])
  @@index([paymentId, createdAt])
  @@map("balance_transactions")
}

model PaymentEvent {
  id         String         @id
  paymentId  String
  payment    Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fromStatus PaymentStatus?
  toStatus   PaymentStatus
  reason     String
  createdAt  DateTime       @default(now())

  @@index([paymentId, createdAt])
  @@map("payment_events")
}

enum SmsStatus {
  queued
  processing
  sent
  failed
}

enum ReceiptNormalizerKind {
  regex
  gemini
  anthropic
}

enum ReceiptRecognitionModel {
  tesseract
  gemini
}

enum PaymentStatus {
  created
  requires_payment_method
  requires_confirmation
  processing
  authorized
  captured
  settled
  failed
  canceled
  refunded
}

enum PaymentMethodType {
  card
  bank_transfer
  wallet
  crypto
  manual
}

enum PaymentBalanceTransactionType {
  payment_capture
  payment_settlement
  refund
  adjustment
}
