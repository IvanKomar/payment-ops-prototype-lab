generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SmsMessage {
  id                String    @id
  phoneNumber       String
  message           String
  idempotencyKey    String?   @unique
  metadata          Json?
  status            SmsStatus
  selectedProvider  String
  providerMessageId String?
  attempts          Int       @default(0)
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sentAt            DateTime?

  @@map("sms_messages")
}

model Receipt {
  id               String                @id
  originalFilename String
  mimeType         String
  sizeBytes        Int
  bank             String?
  transactionDate  String?
  amount           Float?
  currency         String?
  sender           String?
  recipient        String?
  transactionId    String?
  utr              String?
  confidence       Float
  normalizedBy     ReceiptNormalizerKind
  requestedModel   ReceiptRecognitionModel @default(tesseract)
  recognitionModel ReceiptRecognitionModel @default(tesseract)
  rawText          String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@map("receipts")
}

enum SmsStatus {
  queued
  processing
  sent
  failed
}

enum ReceiptNormalizerKind {
  regex
  gemini
  anthropic
}

enum ReceiptRecognitionModel {
  tesseract
  gemini
}
